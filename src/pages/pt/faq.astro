---
import '../../styles/global.css';
---
<!DOCTYPE html><html lang="pt"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>FAQ — MAGColor Experience Lisboa 2026</title></head><body>
<script>document.querySelectorAll('[data-fade]').forEach(el=>{new IntersectionObserver((e,o)=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}})},{threshold:0.12}).observe(el)});document.querySelectorAll('[data-lang]').forEach(el=>{el.addEventListener('click',(e)=>{e.preventDefault();const l=el.dataset.lang;const p=window.location.pathname.replace(/^\/(pt|es|en)\//,'/'+l+'/').replace(/^\/(pt|es|en)$/,'/'+l);window.location.href=p})})</script>
<article class="page">
  <div class="pt-flag"></div>
<header class="hdr"><div class="hdr-inner"><a href="/pt/"><img src="/logo.png" class="logo" alt="MAGColor"></a><nav class="nav"><a href="/pt/" class="nav-item">Início</a><a href="/pt/ponentes" class="nav-item">Palestrantes</a><a href="/pt/programa" class="nav-item">Programa</a><a href="/pt/entradas" class="nav-item">Ingressos</a><a href="/pt/faq" class="nav-item active">FAQ</a></nav><button class="hamburger" onclick="this.parentElement.querySelector(`.nav`).classList.toggle(`open`)"><span></span></button>
<div class="hdr-right"><div class="lang"><a href="#" data-lang="pt" class="lang-pill active">PT</a><a href="#" data-lang="es" class="lang-pill">ES</a><a href="#" data-lang="en" class="lang-pill">EN</a></div><a href="/pt/entradas" class="btn btn-gold btn-sm">Garantir minha entrada</a></div></div></header>
<section class="sec" style="padding-top:140px">

<div style=""><div class="wrap" data-fade>
<div class="center-block" style="margin-bottom:48px"><div class="badge">FAQ</div><h2 class="h2">Tudo o que você precisa saber</h2></div>
<div class="faq" id="faq-list"></div>
</div></section>
<a class="wa-float" href="https://wa.me/34696808098" target="_blank" rel="noreferrer" aria-label="WhatsApp"><span class="wa-dot"></span></a>
<footer class="footer"><img src="/logo-horizontal.jpg" class="footer-logo" alt="MAGColor Experience Lisboa"><p>MAGColor Experience Lisboa 2026</p><p>Evento organizado por Instituto Miriam Alcántara</p><p>Consultas pelo WhatsApp: +34 696 808 098</p><p>© 2026 MAGColor Experience Lisboa. Todos os direitos reservados.</p></footer>
</article>
<script is:inline src="/data.js"></script>
</body></html>
