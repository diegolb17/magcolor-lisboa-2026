---
import '../../styles/global.css';
---
<!DOCTYPE html><html lang="pt"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><link rel="icon" type="image/png" href="/favicon.png">
<title>Palestrantes — MAGColor Experience Lisboa 2026</title></head><body>
<script>document.querySelectorAll('[data-fade]').forEach(el=>{new IntersectionObserver((e,o)=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}})},{threshold:0.12}).observe(el)});document.querySelectorAll('[data-lang]').forEach(el=>{el.addEventListener('click',(e)=>{e.preventDefault();const l=el.dataset.lang;const p=window.location.pathname.replace(/^\/(pt|es|en)\//,'/'+l+'/').replace(/^\/(pt|es|en)$/,'/'+l);window.location.href=p})});setTimeout(function(){document.querySelectorAll("[data-fade]:not(.is-visible)").forEach(function(e){e.classList.add("is-visible")})},1500)</script>
<article class="page">
  <div class="pt-flag"></div>
<header class="hdr"><div class="hdr-inner"><a href="/pt/"><img src="/logo.png" class="logo" alt="MAGColor"></a><nav class="nav"><a href="/pt/" class="nav-item">Início</a><a href="/pt/ponentes" class="nav-item active">Palestrantes</a><a href="/pt/programa" class="nav-item">Programa</a><a href="/pt/entradas" class="nav-item">Ingressos</a><a href="/pt/patrocinadores" class="nav-item">Patrocinadores</a>
<a href="/pt/faq" class="nav-item">FAQ</a></nav><button class="hamburger" onclick="this.parentElement.querySelector(`.nav`).classList.toggle(`open`)"><span></span></button>
<div class="hdr-right"><div class="lang"><button data-lang="pt" class="lang-pill active">PT</button><button data-lang="es" class="lang-pill">ES</button><button data-lang="en" class="lang-pill">EN</button></div><a href="/pt/entradas" class="btn btn-gold btn-sm">Garantir minha entrada</a></div></div></header>
<section class="sec" style="padding-top:140px"><div class="wrap" data-fade>
<div class="center-block" style="margin-bottom:48px"><div class="badge">PALESTRANTES</div><h2 class="h2">Referências da indústria, no mesmo palco</h2><p class="sub-tert">O MAGColor Experience reunirá profissionais com ampla experiência, criadores de técnicas inovadoras e visão internacional.</p></div>
<div class="sp-grid" id="sp-grid"></div>
<div style="text-align:center;margin-top:64px"><div class="badge">DEMONSTRAÇÕES AO VIVO — DIA 2</div></div>
<div class="grid-4 mt-48" id="demos-grid"></div>
<div style="text-align:center;margin-top:64px"><div class="badge">JURADOS</div></div>
<div class="grid-4 mt-48" id="jurados-grid"></div>
<div style="text-align:center;margin-top:64px"><div class="badge">EMBAIXADORAS</div></div>
<div class="grid-4 mt-48" id="embajadoras-grid"></div>
</div></section>
<a class="wa-float" href="https://wa.me/34696808098?text=Ol%C3%A1,%20desejo%20adquirir%20entradas%20ao%20MAG%20Color%20Experience%20Lisboa%202026" target="_blank" rel="noreferrer" aria-label="WhatsApp"><span class="wa-dot"></span></a>
<footer class="footer"><img src="/logo-horizontal.jpg" class="footer-logo" alt="MAGColor Experience Lisboa"><p>MAGColor Experience Lisboa 2026</p><p>Evento organizado por Instituto Miriam Alcántara</p><p>Consultas pelo WhatsApp: +34 696 808 098</p><div style="margin-top:8px"><a href="https://www.instagram.com/institutomiriamalcantara/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;color:var(--text-2);font-size:.9rem;transition:color .2s" onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--text-2)'"><img src="/ig-logo.png" alt="Instagram" style="width:24px;height:24px">@institutomiriamalcantara</a></div><p>© 2026 MAGColor Experience Lisboa. Todos os direitos reservados.</p></footer>
</article>
<script is:inline src="/data.js"></script>
</body></html>
