<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="MAGColor Experience Lisbon 2026">
<meta name="twitter:description" content="International micropigmentation congress in Lisbon, 24 and 25 October 2026. International speakers, live championship and awards gala.">
<meta name="twitter:image" content="https://lisboa2026.institutomiriamalcantara.com/og-image.jpg">
