<meta name="description" content="International micropigmentation congress in Lisbon, 24 and 25 October 2026. International speakers, live championship and awards gala.">
<meta name="theme-color" content="#050508">
<link rel="canonical" href="https://lisboa2026.institutomiriamalcantara.com/en/">
<link rel="alternate" hreflang="pt-PT" href="https://lisboa2026.institutomiriamalcantara.com/pt/">
<link rel="alternate" hreflang="es-ES" href="https://lisboa2026.institutomiriamalcantara.com/es/">
<link rel="alternate" hreflang="en" href="https://lisboa2026.institutomiriamalcantara.com/en/">
<link rel="alternate" hreflang="x-default" href="https://lisboa2026.institutomiriamalcantara.com/pt/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="MAGColor Experience Lisboa 2026">
<meta property="og:locale" content="en_GB">
<meta property="og:locale:alternate" content="pt_PT">
<meta property="og:locale:alternate" content="es_ES">
<meta property="og:title" content="MAGColor Experience Lisbon 2026">
<meta property="og:description" content="International micropigmentation congress in Lisbon, 24 and 25 October 2026. International speakers, live championship and awards gala.">
<meta property="og:url" content="https://lisboa2026.institutomiriamalcantara.com/en/">
<meta property="og:image" content="https://lisboa2026.institutomiriamalcantara.com/og-image.jpg">
