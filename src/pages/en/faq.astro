<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>FAQ — MAGColor Experience Lisboa 2026</title></head><body>
<script>document.querySelectorAll('[data-fade]').forEach(el=>{new IntersectionObserver((e,o)=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}})},{threshold:0.12}).observe(el)});document.querySelectorAll('[data-lang]').forEach(el=>{el.addEventListener('click',(e)=>{e.preventDefault();const l=el.dataset.lang;const p=window.location.pathname.replace(/^\/(pt|es|en)\//,'/'+l+'/').replace(/^\/(pt|es|en)$/,'/'+l);window.location.href=p})})</script>
<article class="page">
  <div class="pt-flag"></div>
<header class="hdr"><div class="hdr-inner"><a href="/en/"><img src="/logo.png" class="logo" alt="MAGColor"></a><nav class="nav"><a href="/en/" class="nav-item">Home</a><a href="/en/ponentes" class="nav-item">Speakers</a><a href="/en/programa" class="nav-item">Program</a><a href="/en/entradas" class="nav-item">Tickets</a><a href="/en/faq" class="nav-item active">FAQ</a></nav><div class="hdr-right"><div class="lang"><a href="#" data-lang="pt" class="lang-pill">PT</a><a href="#" data-lang="es" class="lang-pill">ES</a><a href="#" data-lang="en" class="lang-pill active">EN</a></div><a href="/en/entradas" class="btn btn-gold btn-sm">Reserve My Spot</a></div></div></header>
<section class="sec" style="padding-top:140px">

<div style=""><div class="wrap" data-fade>
