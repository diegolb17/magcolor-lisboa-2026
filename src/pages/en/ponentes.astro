<script>document.querySelectorAll('[data-fade]').forEach(el=>{new IntersectionObserver((e,o)=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}})},{threshold:0.12}).observe(el)});document.querySelectorAll('[data-lang]').forEach(el=>{el.addEventListener('click',(e)=>{e.preventDefault();const l=el.dataset.lang;const p=window.location.pathname.replace(/^\/(pt|es|en)\//,'/'+l+'/').replace(/^\/(pt|es|en)$/,'/'+l);window.location.href=p})});setTimeout(function(){document.querySelectorAll("[data-fade]:not(.is-visible)").forEach(function(e){e.classList.add("is-visible")})},1500)</script>
<article class="page">
  <div class="pt-flag"></div>
<header class="hdr"><div class="hdr-inner"><a href="/en/"><img src="/logo.png" class="logo" alt="MAGColor"></a><nav class="nav"><a href="/en/" class="nav-item">Home</a><a href="/en/ponentes" class="nav-item active">Speakers</a><a href="/en/programa" class="nav-item">Program</a><a href="/en/entradas" class="nav-item">Tickets</a><a href="/en/patrocinadores" class="nav-item">Sponsors</a>
