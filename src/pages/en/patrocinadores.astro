---
import '../../styles/global.css';
---
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><link rel="icon" type="image/png" href="/favicon.png">
<title>Sponsors — MAGColor Experience Lisbon 2026</title></head><body>
<script>
document.querySelectorAll('[data-fade]').forEach(el=>{new IntersectionObserver((e,o)=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('is-visible');o.unobserve(x.target)}})},{threshold:0.12}).observe(el)});
document.querySelectorAll('[data-lang]').forEach(el=>{el.addEventListener('click',(e)=>{e.preventDefault();const l=el.dataset.lang;const p=window.location.pathname.replace(/^\/(pt|es|en)\//,'/'+l+'/').replace(/^\/(pt|es|en)\/*$/,'/'+l);window.location.href=p})});
</script>
<article class="page"><div class="pt-flag"></div>
<header class="hdr"><div class="hdr-inner"><a href="/en/"><img src="/logo.png" class="logo" alt="MAGColor"></a><button class="hamburger" onclick="this.parentElement.querySelector('.nav').classList.toggle('open')"><span></span></button><nav class="nav"><a href="/en/" class="nav-item">Home</a><a href="/en/ponentes" class="nav-item">Speakers</a><a href="/en/programa" class="nav-item">Program</a><a href="/en/entradas" class="nav-item">Tickets</a><a href="/en/patrocinadores" class="nav-item active">Sponsors</a><a href="/en/faq" class="nav-item">FAQ</a></nav><div class="hdr-right"><div class="lang"><button data-lang="pt" class="lang-pill">PT</button><button data-lang="es" class="lang-pill">ES</button><button data-lang="en" class="lang-pill active">EN</button></div><a href="/en/entradas" class="btn btn-gold btn-sm">Reserve My Spot</a></div></div></header>
<section class="sec" style="padding-top:140px"><div class="wrap" data-fade>
<div class="center-block" style="margin-bottom:48px"><div class="badge">SPONSORS</div><h2 class="h2">Companies that make MAGColor Experience possible</h2></div>
<div class="grid-2" style="max-width:700px;margin:0 auto">
  <div class="card" style="padding:48px;display:flex;align-items:center;justify-content:center"><img src="/assets/sponsors/sponsor-1.jpg" alt="Sponsor" style="max-width:100%;max-height:120px;object-fit:contain;filter:brightness(0.9)"></div>
  <div class="card" style="padding:48px;display:flex;align-items:center;justify-content:center"><img src="/assets/sponsors/sponsor-2.jpg" alt="Sponsor" style="max-width:100%;max-height:120px;object-fit:contain;filter:brightness(0.9)"></div>
</div>
<div style="text-align:center;margin-top:64px"><a href="https://wa.me/34696808098?text=Hello,%20I%20want%20to%20be%20a%20sponsor%20of%20MAG%20Color%20Lisbon%202026" class="btn btn-outline btn-lg">Want to be a sponsor? Contact us</a></div>
</div></section>
<a class="wa-float" href="https://wa.me/34696808098?text=Hello,%20I%20want%20to%20buy%20tickets%20for%20MAG%20Color%20Experience%20Lisbon%202026" target="_blank" rel="noreferrer" aria-label="WhatsApp"><span class="wa-dot"></span></a>
<footer class="footer"><img src="/logo-horizontal.jpg" class="footer-logo" alt="MAGColor Experience Lisbon"><p>MAGColor Experience Lisbon 2026</p><p>Event organized by Instituto Miriam Alcántara</p><p>WhatsApp inquiries: +34 696 808 098</p><p><a href="https://www.instagram.com/institutomiriamalcantara/" target="_blank" rel="noopener" style="color:var(--text-3)"><img src="/ig-logo.png" alt="Instagram" style="width:16px;height:16px;vertical-align:middle;margin-right:4px">@institutomiriamalcantara</a></p><p>© 2026 MAGColor Experience Lisbon. All rights reserved.</p></footer>
</article>
</body></html>
